// Prisma schema for BEEM (Beauty Empire)
// To switch to PostgreSQL: change provider to "postgresql" and replace sqlite URL with postgresql URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  emailVerified  DateTime?
  phone          String?   @unique
  passwordHash   String?
  role           String    @default("CUSTOMER") // "CUSTOMER", "STYLIST", "ADMIN"
  image          String?
  loyaltyPoints  Int       @default(0)
  referralCode   String    @unique @default(cuid())
  referredById   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  profile             CustomerProfile?
  stylist             Stylist?
  appointments        Appointment[]
  reviews             Review[]
  favorites           Favorite[]
  lookBoards          LookBoard[]
  loyaltyTransactions LoyaltyTransaction[]
  giftCardsPurchased  GiftCard[]           @relation("PurchasedGiftCards")
  memberships         Membership[]
  accounts            Account[]
  sessions            Session[]
  notifications       Notification[]
  referrer            User?                @relation("UserReferrals", fields: [referredById], references: [id])
  referees            User[]               @relation("UserReferrals")

  @@index([email])
  @@index([phone])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CustomerProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  allergies          String?
  skinType           String?   // "Oily", "Dry", "Combination", "Sensitive", "Normal"
  hairType           String?   // "Straight", "Wavy", "Curly", "Coily"
  scalpType          String?   // "Dry", "Oily", "Normal"
  preferredStylistId String?
  beautyGoals        String?
  emergencyContact   String?
  birthday           DateTime?
  anniversary        DateTime?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Stylist {
  id              String   @id @default(cuid())
  userId          String?  @unique
  name            String
  email           String   @unique
  phone           String
  bio             String?
  avatar          String?
  specialties     String   // Comma-separated or JSON
  experienceYears Int      @default(3)
  rating          Float    @default(4.9)
  reviewCount     Int      @default(0)
  isActive        Boolean  @default(true)
  commissionRate  Float    @default(0.15) // 15%
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  schedules    StylistSchedule[]
  timeOffs     TimeOff[]
  appointments Appointment[]
  reviews      Review[]
  attendance   StaffAttendance[]
  galleryItems GalleryItem[]

  @@index([isActive])
}

model StylistSchedule {
  id           String  @id @default(cuid())
  stylistId    String
  dayOfWeek    Int     // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime    String  @default("09:00") // 24-hr format "09:00"
  endTime      String  @default("19:00") // 24-hr format "19:00"
  isWorkingDay Boolean @default(true)

  stylist Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)

  @@unique([stylistId, dayOfWeek])
}

model TimeOff {
  id        String   @id @default(cuid())
  stylistId String?  // Null means salon-wide holiday
  startDate DateTime
  endDate   DateTime
  reason    String
  type      String   @default("LEAVE") // "HOLIDAY", "SICK", "LEAVE", "BLOCKED"
  createdAt DateTime @default(now())

  stylist Stylist? @relation(fields: [stylistId], references: [id], onDelete: Cascade)

  @@index([stylistId])
  @@index([startDate, endDate])
}

model ServiceCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  icon        String?  // Lucide icon name
  orderIndex  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services Service[]
}

model Service {
  id               String   @id @default(cuid())
  categoryId       String
  name             String
  slug             String   @unique
  description      String
  durationMinutes  Int      @default(45)
  price            Float
  discountedPrice  Float?
  image            String?
  isPopular        Boolean  @default(false)
  isActive         Boolean  @default(true)
  prepInstructions String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category         ServiceCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  appointmentItems AppointmentItem[]
  reviews          Review[]
  favorites        Favorite[]

  @@index([categoryId])
  @@index([isActive])
}

model BridalPackage {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  tier           String   @default("PREMIUM") // "BASIC", "PREMIUM", "ROYAL"
  tagline        String
  description    String
  price          Float
  advanceDeposit Float    // 25-50% required to block date
  durationHours  Float    @default(4.0)
  inclusions     String   // JSON string of included services
  highlights     String   // JSON string of bullet highlights
  isPopular      Boolean  @default(false)
  image          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  appointmentItems AppointmentItem[]
}

model MehendiDesign {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  style         String   // "Arabic", "Rajasthani", "Indo-Arabic", "Minimal", "Bridal Full-hand", "Kids"
  complexity    String   @default("Medium") // "Simple", "Medium", "Intricate", "Bridal Luxury"
  estimatedTime String   @default("60 mins")
  price         Float
  image         String
  tags          String   // Comma separated
  isFeatured    Boolean  @default(false)
  createdAt     DateTime @default(now())

  appointmentItems AppointmentItem[]
  favorites        Favorite[]

  @@index([style])
  @@index([isFeatured])
}

model GalleryItem {
  id          String   @id @default(cuid())
  title       String
  category    String   // "Hair", "Bridal", "Mehendi", "Makeup", "Nails", "Skin"
  imageUrl    String
  description String?
  stylistId   String?
  isFeatured  Boolean  @default(false)
  likesCount  Int      @default(0)
  createdAt   DateTime @default(now())

  stylist   Stylist?   @relation(fields: [stylistId], references: [id], onDelete: SetNull)
  favorites Favorite[]

  @@index([category])
  @@index([isFeatured])
}

model Appointment {
  id                 String   @id @default(cuid())
  appointmentNumber  String   @unique
  userId             String?
  customerName       String
  customerPhone      String
  customerEmail      String
  stylistId          String?
  date               DateTime // Appointment date (00:00:00 UTC representation)
  startTime          String   // e.g. "10:00"
  endTime            String   // e.g. "11:30"
  status             String   @default("PENDING") // "PENDING", "CONFIRMED", "COMPLETED", "CANCELLED", "NO_SHOW"
  totalAmount        Float
  discountAmount     Float    @default(0)
  advancePaid        Float    @default(0)
  balanceDue         Float    @default(0)
  paymentStatus      String   @default("PENDING") // "PENDING", "PARTIAL", "COMPLETED", "REFUNDED"
  paymentMethod      String   @default("CASH_AT_SALON") // "MOCK_PAYMENT", "RAZORPAY_MOCK", "RAZORPAY_UPI", "RAZORPAY_CARD", "CASH_AT_SALON"
  isBridal           Boolean  @default(false)
  isHomeVisit        Boolean  @default(false)
  venueAddress       String?
  distanceKm         Float    @default(0)
  distanceSurcharge  Float    @default(0)
  groupSize          Int      @default(1)
  notes              String?
  lookBoardId        String?
  cancellationReason String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  stylist      Stylist?          @relation(fields: [stylistId], references: [id], onDelete: SetNull)
  items        AppointmentItem[]
  payments     Payment[]
  invoice      Invoice?
  reviews      Review[]
  lookBoard    LookBoard?        @relation(fields: [lookBoardId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([stylistId, date])
  @@index([status])
  @@index([customerPhone])
  @@index([customerEmail])
}

model AppointmentItem {
  id              String  @id @default(cuid())
  appointmentId   String
  serviceId       String?
  bridalPackageId String?
  mehendiDesignId String?
  name            String
  price           Float
  durationMinutes Int     @default(45)

  appointment   Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service       Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  bridalPackage BridalPackage? @relation(fields: [bridalPackageId], references: [id], onDelete: SetNull)
  mehendiDesign MehendiDesign? @relation(fields: [mehendiDesignId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
}

model Payment {
  id                String   @id @default(cuid())
  appointmentId     String
  amount            Float
  currency          String   @default("INR")
  status            String   @default("INITIATED") // "INITIATED", "SUCCESS", "FAILED", "REFUNDED"
  method            String   // "MOCK_PAYMENT", "RAZORPAY", "CASH"
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  transactionRef    String?  @unique
  isMock            Boolean  @default(true)
  createdAt         DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([status])
}

model Invoice {
  id             String    @id @default(cuid())
  invoiceNumber  String    @unique
  appointmentId  String    @unique
  subtotal       Float
  taxAmount      Float     @default(0) // GST 18% or configured rate
  discountAmount Float     @default(0)
  totalAmount    Float
  status         String    @default("PAID") // "PAID", "UNPAID", "CANCELLED"
  pdfUrl         String?
  issuedAt       DateTime  @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model Review {
  id            String    @id @default(cuid())
  appointmentId String?
  serviceId     String?
  stylistId     String?
  userId        String?
  customerName  String
  rating        Int       @default(5)
  comment       String
  photoUrl      String?
  isVerified    Boolean   @default(true)
  ownerReply    String?
  repliedAt     DateTime?
  createdAt     DateTime  @default(now())

  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  service     Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  stylist     Stylist?     @relation(fields: [stylistId], references: [id], onDelete: SetNull)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([rating])
  @@index([serviceId])
  @@index([stylistId])
}

model Favorite {
  id              String   @id @default(cuid())
  userId          String
  serviceId       String?
  mehendiDesignId String?
  galleryItemId   String?
  createdAt       DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  service       Service?       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  mehendiDesign MehendiDesign? @relation(fields: [mehendiDesignId], references: [id], onDelete: Cascade)
  galleryItem   GalleryItem?   @relation(fields: [galleryItemId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceId])
  @@unique([userId, mehendiDesignId])
  @@unique([userId, galleryItemId])
}

model LookBoard {
  id          String   @id @default(cuid())
  userId      String
  title       String   @default("My Inspiration Board")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        LookBoardItem[]
  appointments Appointment[]

  @@index([userId])
}

model LookBoardItem {
  id          String   @id @default(cuid())
  lookBoardId String
  imageUrl    String
  note        String?
  createdAt   DateTime @default(now())

  lookBoard LookBoard @relation(fields: [lookBoardId], references: [id], onDelete: Cascade)

  @@index([lookBoardId])
}

model LoyaltyTransaction {
  id            String   @id @default(cuid())
  userId        String
  points        Int      // Positive for earned, negative for redeemed
  type          String   // "EARNED", "REDEEMED", "BONUS", "REFERRAL"
  description   String
  appointmentId String?
  balanceAfter  Int
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Referral {
  id             String   @id @default(cuid())
  referrerId     String
  referredUserId String   @unique
  status         String   @default("PENDING") // "PENDING", "REWARDED"
  rewardPoints   Int      @default(200)
  createdAt      DateTime @default(now())

  @@index([referrerId])
}

model PromoCode {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String
  discountType   String    @default("PERCENTAGE") // "PERCENTAGE", "FIXED"
  discountValue  Float
  minOrderValue  Float     @default(0)
  maxDiscount    Float?
  validFrom      DateTime  @default(now())
  validUntil     DateTime
  usageLimit     Int?
  timesUsed      Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  offers Offer[]

  @@index([code])
  @@index([isActive])
}

model Offer {
  id           String    @id @default(cuid())
  title        String
  bannerImage  String?
  discountText String
  promoCodeId  String?
  description  String
  validUntil   DateTime
  isFestival   Boolean   @default(false)
  festivalName String?   // "Diwali Special", "Karva Chauth Glow", "Wedding Season", "Eid Special"
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  promoCode PromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([isFestival])
}

model GiftCard {
  id             String    @id @default(cuid())
  code           String    @unique
  purchaserId    String?
  recipientName  String
  recipientEmail String
  recipientPhone String?
  initialAmount  Float
  balanceAmount  Float
  message        String?
  expiryDate     DateTime
  isRedeemed     Boolean   @default(false)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  purchaser User? @relation("PurchasedGiftCards", fields: [purchaserId], references: [id], onDelete: SetNull)

  @@index([code])
}

model MembershipPlan {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  period          String   @default("YEARLY") // "MONTHLY", "YEARLY"
  price           Float
  discountPercent Float    @default(20.0) // 20% off all services
  perks           String   // JSON list of perks
  description     String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  memberships Membership[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  planId    String
  startDate DateTime @default(now())
  endDate   DateTime
  status    String   @default("ACTIVE") // "ACTIVE", "EXPIRED", "CANCELLED"
  createdAt DateTime @default(now())

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId])
}

model InventoryItem {
  id              String    @id @default(cuid())
  name            String
  sku             String    @unique
  category        String    // "Hair Color", "Wax", "Skincare", "Nails", "Tools"
  currentStock    Int
  minStockAlert   Int       @default(5)
  unit            String    @default("units")
  costPrice       Float
  supplier        String?
  lastRestockedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([category])
}

model StaffAttendance {
  id        String    @id @default(cuid())
  stylistId String
  date      DateTime  // 00:00:00 date
  checkIn   String?   // "09:15"
  checkOut  String?   // "19:05"
  status    String    @default("PRESENT") // "PRESENT", "ABSENT", "HALF_DAY", "ON_LEAVE"
  notes     String?
  createdAt DateTime  @default(now())

  stylist Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)

  @@unique([stylistId, date])
}

model BlogPost {
  id                 String    @id @default(cuid())
  title              String
  slug               String    @unique
  excerpt            String
  content            String    // Markdown or rich text
  coverImage         String
  author             String    @default("BEEM Master Stylist")
  tags               String    // Comma separated
  readingTimeMinutes Int       @default(4)
  isPublished        Boolean   @default(true)
  publishedAt        DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([slug])
  @@index([isPublished])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String?
  type      String    // "APPOINTMENT_CONFIRMED", "REMINDER_24H", "REMINDER_2H", "PAYMENT_SUCCESS", "PROMO", "SYSTEM"
  channel   String    @default("WHATSAPP") // "WHATSAPP", "SMS", "EMAIL", "IN_APP"
  recipient String    // Phone or email
  title     String
  message   String
  status    String    @default("SENT") // "PENDING", "SENT", "FAILED"
  sentAt    DateTime? @default(now())
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([status])
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   // Text or stringified JSON
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}
