# ==============================================================================
# BEEM (Beauty Empire) - Key-Free & AI-Free Configuration
# Run: node scripts/setup-env.mjs to generate a fresh .env automatically
# Zero third-party accounts, APIs, or external tokens required.
# ==============================================================================

# 1. Database (PostgreSQL / Neon for Production & Vercel, or SQLite for local)
# For Neon / PostgreSQL with connection pooling:
DATABASE_URL="postgresql://user:password@ep-host-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-host.region.aws.neon.tech/neondb?sslmode=require"
# For SQLite local fallback:
# DATABASE_URL="file:./dev.db"

# 2. Local Session Signing & Field Encryption (Self-Generated Secrets)
NEXTAUTH_SECRET="your-generated-64-character-secret"
AUTH_SECRET="your-generated-64-character-secret"
NEXTAUTH_URL="http://localhost:3000"
DATA_ENCRYPTION_KEY="your-generated-64-character-encryption-key"

# 3. Application URLs & Metadata
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 4. Salon Contact & Local UPI Configuration (No Gateway Needed)
NEXT_PUBLIC_SALON_NAME="BEEM (Beauty Empire)"
NEXT_PUBLIC_SALON_PHONE="+919876543210"
NEXT_PUBLIC_SALON_WHATSAPP="919876543210"
NEXT_PUBLIC_SALON_EMAIL="contact@beem.luxury"
NEXT_PUBLIC_SALON_ADDRESS="Shop 12-14, Luxury Promenade, 100 Feet Road, Indiranagar, Bengaluru, Karnataka 560038"
NEXT_PUBLIC_SALON_UPI_ID="beem.luxury@upi"
NEXT_PUBLIC_SALON_UPI_NAME="BEEM Beauty Empire"

# 5. Disable Next.js Telemetry
NEXT_TELEMETRY_DISABLED="1"
