# BEEM (Beauty Empire) Environment Variables
# The app works 100% out of the box with zero external API keys!

# Database (SQLite default; change to postgresql://user:pass@host:5432/dbname for PostgreSQL)
DATABASE_URL="file:./dev.db"

# NextAuth Authentication
NEXTAUTH_SECRET="your-nextauth-secret-here-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: Razorpay Payment Gateway (when empty, MOCK PAYMENT MODE is automatically active)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Optional: Anthropic Claude for AI Stylist Chatbot (when empty, smart rule-based FAQ bot runs seamlessly)
ANTHROPIC_API_KEY=""

# Optional: Cloudinary for user image uploads
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Salon Official WhatsApp & Contact
NEXT_PUBLIC_SALON_WHATSAPP="+919876543210"
NEXT_PUBLIC_SALON_PHONE="+919876543210"
NEXT_PUBLIC_SALON_EMAIL="contact@beem.test"
NEXT_PUBLIC_SALON_ADDRESS="Shop 12-14, Luxury Promenade, Indiranagar, Bengaluru, Karnataka 560038"
